# Copy to `.env` in this folder (apps/compliance-service/.env).
# Run services from `backend/` so paths resolve correctly.
# Never commit `.env` or real credentials.

PORT=3008

# Aiven MySQL (compliance_db)
DB_HOST=
DB_PORT=16659
DB_USER=
DB_PASSWORD=
DB_NAME=compliance_db

# Resolved relative to backend root (place ca.pem in backend/)
DB_SSL_CA=ca.pem